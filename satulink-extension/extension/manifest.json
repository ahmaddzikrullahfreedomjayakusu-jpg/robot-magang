    "https://*.mola.tv/*",
    "https://*.rctiplus.com/*",
    "https://*.visionplus.id/*",
    "https://*.klikfilm.com/*",
    "https://*.bioskoponline.com/*"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
