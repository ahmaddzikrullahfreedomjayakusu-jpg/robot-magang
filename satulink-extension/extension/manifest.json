    "https://copilot.microsoft.com/*",
    "https://*.blackbox.ai/*",
    "https://*.phind.com/*",
    "https://*.replit.com/*",
    "https://*.codeium.com/*",
    "https://*.cursor.sh/*",
    "https://*.poe.com/*",

